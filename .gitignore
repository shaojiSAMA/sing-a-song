# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ===== 构建产物 =====
build/
dist/
*.zip
*.spec.bak

# ===== 运行日志 / 临时文件 =====
*.log
_smoke*
pkg_test_id.txt

# ===== 用户数据（每台机器各自生成，勿入库）=====
library/
lrcs/*
!lrcs/.gitkeep
runtime/

# 分离模型（67MB，首次运行自动下载/由发行包内置）
models/*
!models/.gitkeep

# FFmpeg 二进制（200MB+，见 README「从源码运行」）
bin/*
!bin/.gitkeep
